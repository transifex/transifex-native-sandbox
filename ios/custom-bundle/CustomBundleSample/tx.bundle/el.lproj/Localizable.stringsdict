<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@arg1@ %2$#@arg2@</string>
		<key>arg1</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld άνθρωπος έχει</string>
			<key>other</key>
			<string>%1$lld άνθρωποι έχουν</string>
		</dict>
		<key>arg2</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld αντικείμενο</string>
			<key>other</key>
			<string>%2$lld αντικείμενα</string>
		</dict>
	</dict>
	<key>%lld Books</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Βιβλίο</string>
			<key>other</key>
			<string>%lld Βιβλία</string>
		</dict>
	</dict>
	<key>This device has %lld stored</key>
	<dict>
		<key>NSStringDeviceSpecificRuleType</key>
		<dict>
			<key>iphone</key>
			<dict>
				<key>NSStringLocalizedFormatKey</key>
				<string>%#@value@</string>
				<key>value</key>
				<dict>
					<key>NSStringFormatSpecTypeKey</key>
					<string>NSStringPluralRuleType</string>
					<key>NSStringFormatValueTypeKey</key>
					<string>lld</string>
					<key>one</key>
					<string>Αυτό το iPhone έχει %lld άνθρωπο αποθηκευμένο</string>
					<key>other</key>
					<string>Αυτό το iPhone έχει %lld ανθρώπους αποθηκευμένους</string>
				</dict>
			</dict>
			<key>mac</key>
			<dict>
				<key>NSStringLocalizedFormatKey</key>
				<string>%#@value@</string>
				<key>value</key>
				<dict>
					<key>NSStringFormatSpecTypeKey</key>
					<string>NSStringPluralRuleType</string>
					<key>NSStringFormatValueTypeKey</key>
					<string>lld</string>
					<key>one</key>
					<string>Αυτό το Mac έχει %lld άνθρωπο αποθηκευμένο</string>
					<key>other</key>
					<string>Αυτό το Mac έχει %lld ανθρώπους αποθηκευμένους</string>
				</dict>
			</dict>
		</dict>
	</dict>
	<key>This is a device</key>
	<dict>
		<key>NSStringDeviceSpecificRuleType</key>
		<dict>
			<key>ipad</key>
			<string>Αυτό είναι ένα iPad</string>
			<key>iphone</key>
			<string>Αυτό είναι ένα iPhone</string>
			<key>mac</key>
			<string>Αυτό είναι ένα Mac</string>
			<key>other</key>
			<string>Αυτή είναι μια συσκευή</string>
		</dict>
	</dict>
	<key>unit-time.%d-minute(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d λεπτό</string>
			<key>other</key>
			<string>%d λεπτά</string>
		</dict>
	</dict>
	<key>unit-time.%u-minute(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>u</string>
			<key>one</key>
			<string>%u λεπτό</string>
			<key>other</key>
			<string>%u λεπτά</string>
		</dict>
	</dict>
</dict>
</plist>
